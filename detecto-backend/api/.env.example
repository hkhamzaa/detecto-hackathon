# Same Postgres instance/database as detecto-backend/db.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/detecto_dev

PORT=4000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Shared secret for local service-to-service calls (detecto-backend/server
# posting new alerts). Not a user credential. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match INTERNAL_API_KEY in detecto-backend/server's environment
# exactly — see server/README.md.
INTERNAL_API_KEY=change-me
